<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Rmmv" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg2</item>
        <item name="android:navigationBarColor">@color/bg2</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">#FFFFFFFF</item>
        <item name="android:textColorPrimary">@color/fg</item>
        <item name="android:textColorSecondary">@color/fg_dim</item>

        <!--
          Material3 auto-inflates every Button as a MaterialButton and tints it
          with colorPrimary, which overrode our own backgrounds and made "Save"
          render as blue text on a blue button. Force the plain AppCompat button
          so each screen's android:background / textColor actually shows.
        -->
        <item name="materialButtonStyle">@style/Widget.AppCompat.Button</item>
    </style>
</resources>
