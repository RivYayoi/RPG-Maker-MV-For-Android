<?xml version="1.0" encoding="utf-8"?>
<!-- Tool > Database: entity tabs + record list + generated detail form. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/bg2"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/db_title"
            android:textColor="@color/fg"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDbAdd"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_button"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/db_add"
            android:textAllCaps="false"
            android:textColor="@color/fg"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnDbDelete"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_button"
            android:enabled="false"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="@string/delete"
            android:textAllCaps="false"
            android:textColor="@color/fg"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnDbSave"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:background="@drawable/bg_button"
            android:minWidth="0dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/save"
            android:textAllCaps="false"
            android:textColor="@color/accent"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <Spinner
        android:id="@+id/spDbType"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_field"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:spinnerMode="dropdown" />

    <TextView
        android:id="@+id/tvDbSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="middle"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="14dp"
        android:paddingBottom="6dp"
        android:singleLine="true"
        android:textColor="@color/fg_dim"
        android:textSize="11sp" />

    <View
        android:id="@+id/vDbDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDbList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.42"
        android:background="@color/bg"
        android:clipToPadding="false"
        android:paddingBottom="6dp"
        android:scrollbars="vertical" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/line" />

    <ScrollView
        android:id="@+id/svDbForm"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.58"
        android:background="@color/bg"
        android:fillViewport="true"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/llDbForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="28dp" />
    </ScrollView>
</LinearLayout>